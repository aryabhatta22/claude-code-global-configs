{
  "cleanupPeriodDays": 30,
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(uv run pytest*)",
      "Bash(uv run ruff*)",
      "Bash(npm run test*)",
      "Bash(npm run lint*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/secrets/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  },
  "model": "opusplan",
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import json; print(json.dumps({'systemMessage': 'PreCompact triggered. Run /update-tracker if tasks were completed this session.', 'additionalContext': 'About to compact. Preserve any task status changes and decisions made this session in the summary.'}))\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'f=\"$CLAUDE_FILE_PATH\"; case \"$f\" in *.py) command -v ruff >/dev/null && ruff format \"$f\" --quiet ;; esac; exit 0'",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "superpowers@superpowers-marketplace": false,
    "claude-code-setup@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    }
  },
  "effortLevel": "medium",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen"
}
